function testConnexionBMC() {
  const url = CONFIG.BMC_BASE_URL + "/api/v1.2/about";
  
  try {
    const response = UrlFetchApp.fetch(url, {
      method: "GET",
      muteHttpExceptions: true,
      followRedirects: true,
      // Pas de token → on teste juste si le serveur répond
    });

    const code = response.getResponseCode();
    Logger.log("✅ Serveur joignable ! HTTP : " + code);
    Logger.log(response.getContentText().substring(0, 300));

  } catch (e) {
    Logger.log("❌ " + e.message);
  }
}
