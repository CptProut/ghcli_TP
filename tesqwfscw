#!/usr/bin/env bash
# ============================================================
#  BMC Discovery — Export CSV des changements (7 derniers jours)
#  Usage : ./bmc_export.sh
#  Prérequis : curl, jq  (brew install jq si absent)
# ============================================================

# ─────────────────────────────────────────────────────────────
#  CONFIGURATION  (à renseigner avant la première exécution)
# ─────────────────────────────────────────────────────────────
BMC_URL="https://VOTRE_INSTANCE_BMC"   # sans slash final
BMC_TOKEN="VOTRE_TOKEN_API"
OUTPUT_DIR="$HOME/Desktop"             # dossier de sortie du CSV
JOURS=7                                # fenêtre temporelle (jours)

# ─────────────────────────────────────────────────────────────
#  NE PAS MODIFIER EN DESSOUS
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# Couleurs terminal
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

info()    { echo -e "${GREEN}[INFO]${NC}  $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC}  $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; exit 1; }

# ── Vérification des dépendances ──────────────────────────────
info "Vérification des dépendances..."
command -v curl &>/dev/null || error "curl non trouvé. Installe-le avec : brew install curl"
command -v jq   &>/dev/null || error "jq non trouvé. Installe-le avec : brew install jq"

# ── Nom du fichier de sortie ──────────────────────────────────
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
OUTPUT_FILE="${OUTPUT_DIR}/bmc_changes_${TIMESTAMP}.csv"

# ── Requête TDL ───────────────────────────────────────────────
TDL_QUERY="search Host where _last_update_time > now() - ${JOURS}d show name, fqdn, os, os_version, ip_address, mac_address, cpu_count, ram, disk_total, serial_no, model, manufacturer, domain, virtual, _last_update_time order by _last_update_time desc"

info "Connexion à BMC Discovery : ${BMC_URL}"
info "Fenêtre temporelle        : ${JOURS} derniers jours"
info "Fichier de sortie         : ${OUTPUT_FILE}"
echo ""

# ── Appel API BMC ─────────────────────────────────────────────
info "Envoi de la requête TDL..."

HTTP_RESPONSE=$(curl --silent --show-error --write-out "HTTPSTATUS:%{http_code}" \
  --max-time 60 \
  --insecure \
  -X POST \
  "${BMC_URL}/api/v1.2/data/search" \
  -H "Authorization: Bearer ${BMC_TOKEN}" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d "{\"query\": \"${TDL_QUERY}\"}")

# Séparer le body du code HTTP
HTTP_BODY=$(echo "$HTTP_RESPONSE" | sed -e 's/HTTPSTATUS:[0-9]*$//')
HTTP_CODE=$(echo "$HTTP_RESPONSE" | tr -d '\n' | sed -e 's/.*HTTPSTATUS://')

# ── Vérification du code HTTP ─────────────────────────────────
if [ "$HTTP_CODE" -eq 401 ]; then
  error "Authentification refusée (401). Vérifie ton token BMC_TOKEN."
elif [ "$HTTP_CODE" -eq 403 ]; then
  error "Accès interdit (403). Ton token n'a pas les droits suffisants."
elif [ "$HTTP_CODE" -eq 404 ]; then
  error "Endpoint introuvable (404). Vérifie BMC_URL et la version de l'API."
elif [ "$HTTP_CODE" -ne 200 ]; then
  error "Erreur HTTP ${HTTP_CODE} :\n${HTTP_BODY}"
fi

info "Réponse reçue (HTTP ${HTTP_CODE}). Traitement des données..."

# ── Extraction des headings et résultats via jq ───────────────
# L'API BMC retourne : { "headings": [...], "results": [[...], [...]] }

HEADINGS=$(echo "$HTTP_BODY" | jq -r '.headings // [] | @csv')
NB_RESULTS=$(echo "$HTTP_BODY" | jq '.results // [] | length')

if [ "$NB_RESULTS" -eq 0 ]; then
  warn "Aucun changement détecté sur les ${JOURS} derniers jours."
  warn "Le fichier CSV sera créé avec uniquement les en-têtes."
fi

info "${NB_RESULTS} machine(s) modifiée(s) trouvée(s)."

# ── Génération du CSV ─────────────────────────────────────────
{
  # En-tête
  echo "$HEADINGS"

  # Lignes de données (chaque résultat est un tableau JSON)
  echo "$HTTP_BODY" | jq -r '
    .results // [] | .[] |
    map(
      if type == "null" then ""
      elif type == "boolean" then if . then "true" else "false" end
      elif type == "number" then tostring
      else tostring
      end
    ) | @csv
  '
} > "$OUTPUT_FILE"

# ── Résumé final ──────────────────────────────────────────────
echo ""
info "✅ Export terminé avec succès !"
info "   Machines modifiées : ${NB_RESULTS}"
info "   Fichier généré     : ${OUTPUT_FILE}"
echo ""

# Ouvrir le dossier Desktop dans le Finder
open "$OUTPUT_DIR"
