function onMessage(event) {
  var name = "";

  // Commande /astreinte
  if (event.message.slashCommand) {
    if (event.message.slashCommand.commandId == 1) { // vérifie l'ID configuré dans Cloud Console
      return getAstreinteCard();
    }
  }

  if (event.space.type == "DM") {
    name = "You";
  } else {
    name = event.user.displayName;
  }

  var message = name + " said \"" + event.message.text + "\"";
  return { "text": message };
}

const ID_SHEET_ASTREINTE = "1ud_1lXLqFqCZWdOb8UreBS9sffI0GidnRaiXy_dY6TY";

function getAstreinteCard() {
  const ss = SpreadsheetApp.openById(ID_SHEET_ASTREINTE);
  const nomfeuilleAstreinte = "Astreinte";

  const aujourdhui = new Date();
  const numeroSemaine = getWeekNumber(aujourdhui).toString();
  const datesAffiche = getRangeDate(aujourdhui);

  let agentSemaine = "", agentWeekend = "";

  const fAstreinte = ss.getSheetByName(nomfeuilleAstreinte);
  if (fAstreinte) {
    const donnees = fAstreinte.getDataRange().getDisplayValues();
    for (var i = 0; i < donnees.length; i++) {
      var texteCellule = donnees[i][0];
      if (texteCellule !== "" && texteCellule === numeroSemaine) {
        agentSemaine = donnees[i][1];
        agentWeekend = donnees[i][2];
        break;
      }
    }
  }

  return {
    "cardsV2": [{
      "cardId": "astreinteCard",
      "card": {
        "header": {
          "title": "Astreinte - Semaine " + numeroSemaine,
          "subtitle": "Du " + datesAffiche
        },
        "sections": [
          {
            "widgets": [
              {
                "decoratedText": {
                  "startIcon": { "materialIcon": { "name": "wb_sunny", "fill": true, "weight": 300, "grade": -25 } },
                  "topLabel": "EN SEMAINE",
                  "text": "<b>" + agentSemaine + "</b>"
                }
              },
              {
                "decoratedText": {
                  "startIcon": { "materialIcon": { "name": "nights_stay", "fill": true, "weight": 300, "grade": -25 } },
                  "topLabel": "WEEK-END",
                  "text": "<b>" + agentWeekend + "</b>"
                }
              }
            ]
          }
        ]
      }
    }]
  };
}

function getWeekNumber(d) {
  d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7));
  var yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  var WeekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
  return WeekNo;
}

function getRangeDate(d) {
  var jour = d.getDay();
  var diffLundi = d.getDate() - jour + (jour == 0 ? -6 : 1);
  var Lundi = new Date(d.setDate(diffLundi));
  var Dimanche = new Date(d.setDate(Lundi.getDate() + 6));
  var f = function(date) {
    return Utilities.formatDate(date, "GMT+1", "dd/MM");
  };
  return f(Lundi) + " au " + f(Dimanche) + ",";
}
