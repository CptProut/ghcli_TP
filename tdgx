SEARCH SoftwareInstance
WHERE type MATCHES '(?i)nginx'
AND (version MATCHES '^1[.](9[.]([5-9]|1[0-9])|(1[0-9]|2[0-9]|30)[.][0-9]+|31[.][0-8])([^0-9]|$)'
  OR product_version MATCHES '^1[.](9[.]([5-9]|1[0-9])|(1[0-9]|2[0-9]|30)[.][0-9]+|31[.][0-8])([^0-9]|$)'
  OR full_version MATCHES '^1[.](9[.]([5-9]|1[0-9])|(1[0-9]|2[0-9]|30)[.][0-9]+|31[.][0-8])([^0-9]|$)')
SHOW name, type, version, full_version, #RunningSoftware:HostedSoftware:Host:Host.name

SEARCH Package
WHERE name MATCHES '(?i)^nginx'
AND version MATCHES '^1[.](9[.]([5-9]|1[0-9])|(1[0-9]|2[0-9]|30)[.][0-9]+|31[.][0-8])([^0-9]|$)'
SHOW name, version, revision, os, #:::Host.name
