# Vide = pas de dépôt SFTP pour ce fichier (le script le signale).
sftp_for() {
    local f="$1" ns
    case "$f" in
        prod/mep.token)
            echo "sftp-nickel-prod@deploy.runiso.com|/token/istio-rke2/mep.token" ;;
        preprod/mep.token)
            echo "" ;;   # TODO ex: "sftp-nickel-preprod@deploy.runiso.com|/token/istio-rke2/mep.token"
        pcidss/mep.token)
            echo "" ;;   # TODO
        hors-prod/*/mep.token)
            ns=$(basename "$(dirname "$f")")
            echo "" ;;   # TODO ex: "sftp-nickel-staging@deploy.runiso.com|/token/$ns/mep.token"
        *)
            echo "" ;;
    esac
}
