for cmd in git jq sftp; do
    command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' introuvable (brew install $cmd)"
done
[[ -d "$REPO_DIR/.git" ]] || die "$REPO_DIR n'est pas un dépôt git\n   → modifie REPO_DIR en haut du script"
git -C "$REPO_DIR" remote get-url origin | grep -q 'k8s-deployment-management' \
    || die "$REPO_DIR ne pointe pas sur k8s-deployment-management"

title "Gestion des comptes de service — mep.token"

status=$(git -C "$REPO_DIR" status --porcelain)
[[ -z "$status" ]] || die "le dépôt contient des modifications non commitées, nettoie avant :\n$status"
info "🔄 Mise à jour du dépôt"
run git -C "$REPO_DIR" pull --rebase --quiet
cd "$REPO_DIR"

# ---------------------------------------------------------------- 1. action
choose "Que veux-tu faire ?" \
    "Ajouter des comptes de service" \
    "Supprimer des comptes de service (→ serviceaccounts_to_delete)" \
    "Nettoyer serviceaccounts_to_delete (après traitement de la suppression)" \
    "Redéposer un mep.token sur le serveur (sans modification)"
case "$CHOICE" in
    Ajouter*)   MODE="add";    ACTION="Ajout";       VERB="ajouter" ;;
    Supprimer*) MODE="delete"; ACTION="Suppression"; VERB="supprimer" ;;
    Nettoyer*)  MODE="clean";  ACTION="Nettoyage";   VERB="retirer de serviceaccounts_to_delete" ;;
    *)          MODE="upload" ;;
esac

if [[ "$MODE" == "upload" ]]; then
    FILES=()
    while IFS= read -r f; do FILES+=("${f#./}"); done < <(find . -name mep.token | sort)
    choose "Quel fichier ?" "${FILES[@]}"
    sftp_upload "$CHOICE"
    info "\n🎉 Terminé"
    exit 0
fi

# ---------------------------------------------------------------- 2. namespace
ALL_NS=()
while IFS= read -r ns; do [[ -n "$ns" ]] && ALL_NS+=("$ns"); done < <(
    {
        for f in prod/mep.token preprod/mep.token pcidss/mep.token hors-prod/mep.token; do
            [[ -f "$f" ]] && jq -r '.namespaces[].namespace' "$f"
        done
        for d in hors-prod/*/ preprod/*/ prod/*/; do
            [[ -f "$d/mep.token" ]] && basename "$d"
        done
    } | sed -E "s/$NS_PREFIX_REGEX//" | sort -u
)

NAMESPACE=""
filtered=("${ALL_NS[@]}")
while [[ -z "$NAMESPACE" ]]; do
    info "\n${B}Namespace ?${N}  (numéro, nom exact, ou un mot pour filtrer — sans préfixe dev-/staging-/preprod-/alpha-)"
    for i in "${!filtered[@]}"; do
        printf '  %s%2d)%s %s\n' "$C" $((i + 1)) "$N" "${filtered[$i]}"
    done
    printf '> '
    read -r rep
    [[ -z "$rep" ]] && { filtered=("${ALL_NS[@]}"); continue; }
    if [[ "$rep" =~ ^[0-9]+$ ]] && (( rep >= 1 && rep <= ${#filtered[@]} )); then
        NAMESPACE="${filtered[$((rep - 1))]}"
    elif in_list "$rep" "${ALL_NS[@]}"; then
        NAMESPACE="$rep"
    else
        new=()
        for ns in "${ALL_NS[@]}"; do [[ "$ns" == *"$rep"* ]] && new+=("$ns"); done
        if [[ ${#new[@]} -gt 0 ]]; then
            filtered=("${new[@]}")
        else
            info "${R}Aucun namespace ne correspond à '$rep'${N} (Entrée pour tout réafficher)"
        fi
    fi
done
info "→ Namespace : ${B}$NAMESPACE${N}"

# ---------------------------------------------------------------- 3. environnements
info "\n${B}Environnements ?${N}  (Entrée = tous, sinon numéros séparés par des espaces)"
for i in "${!ENVS[@]}"; do printf '  %s%2d)%s %s\n' "$C" $((i + 1)) "$N" "${ENVS[$i]}"; done
SEL_ENVS=()
while [[ ${#SEL_ENVS[@]} -eq 0 ]]; do
    printf '> '
    read -r rep
    if [[ -z "$rep" ]]; then
        SEL_ENVS=("${ENVS[@]}")
    else
        for n in $rep; do
            if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#ENVS[@]} )); then
                SEL_ENVS+=("${ENVS[$((n - 1))]}")
            else
                info "${R}Choix invalide : $n${N}"; SEL_ENVS=(); break
            fi
        done
    fi
done

# Résout les cibles (fichier + vrai namespace) et vérifie leur existence
T_FILES=(); T_NS=()
info "\n${B}Cibles :${N}"
for t in "${TARGETS[@]}"; do
    env="${t%%|*}"; rest="${t#*|}"; file="${rest%%|*}"; nsp="${rest#*|}"
    in_list "$env" "${SEL_ENVS[@]}" || continue
    file="${file//\{NS\}/$NAMESPACE}"
    nsp="${nsp//\{NS\}/$NAMESPACE}"
    if [[ ! -f "$file" ]]; then
        warn "$env : fichier $file absent, ignoré"
    elif ! ns_exists "$file" "$nsp"; then
        warn "$env : namespace '$nsp' absent de $file, ignoré"
    else
        info "  ${G}✓${N} $env : $file → $nsp"
        T_FILES+=("$file"); T_NS+=("$nsp")
    fi
done
[[ ${#T_FILES[@]} -gt 0 ]] || die "aucune cible valide pour '$NAMESPACE'"
in_list "prod" "${SEL_ENVS[@]}" && info "${R}${B}⚠️  La PROD fait partie des cibles${N}"

# Aide : pour le nettoyage, on affiche ce qu'il y a dans to_delete
if [[ "$MODE" == "clean" ]]; then
    info "\nContenu actuel de serviceaccounts_to_delete :"
    for i in "${!T_FILES[@]}"; do
        list=$(jq -r --arg ns "${T_NS[$i]}" \
            '.namespaces[] | select(.namespace == $ns) | (.serviceaccounts_to_delete // []) | join(", ")' "${T_FILES[$i]}")
        info "  ${T_NS[$i]} (${T_FILES[$i]}) : ${list:-<vide>}"
    done
fi

# ---------------------------------------------------------------- 4. comptes
SAS=()
while [[ ${#SAS[@]} -eq 0 ]]; do
    info "\n${B}Compte(s) de service à $VERB${N} (séparés par des espaces) :"
    printf '> '
    read -r line
    ok=true
    for sa in $line; do
        if [[ ! "$sa" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || (( ${#sa} > 63 )); then
            info "${R}Nom invalide : '$sa'${N} (minuscules, chiffres, '-', 63 car. max)"
            ok=false
        elif [[ ${#SAS[@]} -eq 0 ]] || ! in_list "$sa" "${SAS[@]}"; then
            SAS+=("$sa")
        fi
    done
    [[ "$ok" == "true" ]] || SAS=()
done
SAS_JSON=$(printf '%s\n' "${SAS[@]}" | jq -R . | jq -s -c .)
LIST=$(printf '%s, ' "${SAS[@]}"); LIST="${LIST%, }"

info "\n${B}Référence du ticket${N} (SCTASK…, RITM…, Entrée si aucune) :"
printf '> '
read -r TICKET

# ---------------------------------------------------------------- 5. modification
for i in "${!T_FILES[@]}"; do
    apply "${T_FILES[$i]}" "${T_NS[$i]}" "$MODE"
done

CHANGED_FILES=()
while IFS= read -r f; do [[ -n "$f" ]] && CHANGED_FILES+=("$f"); done \
    < <(git diff --name-only)
if [[ ${#CHANGED_FILES[@]} -eq 0 ]]; then
    info "\nRien à modifier (comptes déjà dans l'état voulu)."
    exit 0
fi

title "Récapitulatif"
info "  Action        : ${B}$ACTION${N}"
info "  Namespace     : ${B}$NAMESPACE${N}"
info "  Comptes       : ${B}$LIST${N}"
info "  Fichiers      : ${B}${CHANGED_FILES[*]}${N}\n"
git --no-pager diff --color

echo
if ! ask_yn "Valider, commiter et pousser ?"; then
    git checkout -- "${CHANGED_FILES[@]}"
    die "annulé, fichiers remis dans leur état d'origine"
fi

MSG="$ACTION SA $LIST dans $NAMESPACE"
[[ -n "$TICKET" ]] && MSG="$TICKET - $MSG"
title "Commit & push"
run git add "${CHANGED_FILES[@]}"
run git commit --quiet -m "$MSG"
run git push --quiet
info "${G}✅ Poussé sur $(git branch --show-current)${N}"

# ---------------------------------------------------------------- 6. SFTP
title "Dépôt SFTP"
for f in "${CHANGED_FILES[@]}"; do
    sftp_upload "$f"
done

if [[ "$MODE" == "delete" ]]; then
    info "\n${Y}Rappel : une fois la suppression traitée, relance le script avec"
    info "« Nettoyer serviceaccounts_to_delete » pour vider la liste.${N}"
fi
info "\n🎉 Terminé"#!/usr/bin/env bash
#
# add-sa.sh — Assistant interactif pour gérer les comptes de service du mep.token
#   1. choix de l'environnement, du namespace, de l'action et des comptes
#   2. modification du mep.token + affichage du diff
#   3. commit / push dans k8s-deployment-management
#   4. sauvegarde du fichier distant puis dépôt en SFTP
#
# Prérequis : bash, git, jq (macOS 15+ ou brew install jq), sftp avec clé SSH.
# Compatible avec le bash 3.2 fourni par macOS.

set -euo pipefail

# ============================================================================
# CONFIGURATION — à adapter
# ============================================================================
REPO_DIR="${REPO_DIR:-$HOME/git/k8s-deployment-management}"
BACKUP_DIR="$HOME/Documents/Token/backups"

ENVS=("hors-prod" "preprod" "prod")

env_config() {
    case "$1" in
        hors-prod)
            TOKEN_FILE="hors-prod/mep.token"
            SFTP_TARGET="sftp-nickel-hors-prod@deploy.runiso.com"   # TODO à vérifier
            REMOTE_PATH="/token/istio-rke2/mep.token"               # TODO à vérifier
            ;;
        preprod)
            TOKEN_FILE="preprod/mep.token"
            SFTP_TARGET="sftp-nickel-preprod@deploy.runiso.com"     # TODO à vérifier
            REMOTE_PATH="/token/istio-rke2/mep.token"               # TODO à vérifier
            ;;
        prod)
            TOKEN_FILE="prod/mep.token"
            SFTP_TARGET="sftp-nickel-prod@deploy.runiso.com"
            REMOTE_PATH="/token/istio-rke2/mep.token"
            ;;
    esac
}
# ============================================================================

# ---------------------------------------------------------------- affichage
if [[ -t 1 ]]; then
    B=$'\e[1m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
else
    B=""; R=""; G=""; Y=""; C=""; N=""
fi
die()   { printf '\n%s❌ %b%s\n' "$R" "$*" "$N" >&2; exit 1; }
info()  { printf '%b\n' "$*"; }
title() { printf '\n%s━━ %s ━━%s\n' "$B$C" "$*" "$N"; }
run()   { printf '  %s$ %s%s\n' "$Y" "$*" "$N"; "$@"; }

ask_yn() {   # ask_yn "question" [défaut o|n]
    local def="${2:-n}" rep prompt="[o/N]"
    [[ "$def" == "o" ]] && prompt="[O/n]"
    while true; do
        printf '%b %s ' "$1" "$prompt"
        read -r rep
        rep="${rep:-$def}"
        case "$rep" in
            [oOyY]*) return 0 ;;
            [nN]*)   return 1 ;;
        esac
    done
}

# Menu numéroté : choose "question" item1 item2 ... -> résultat dans $CHOICE
choose() {
    local q="$1"; shift
    local items=("$@") i rep
    while true; do
        info "\n${B}$q${N}"
        for i in "${!items[@]}"; do
            printf '  %s%2d)%s %s\n' "$C" $((i + 1)) "$N" "${items[$i]}"
        done
        printf '> '
        read -r rep
        if [[ "$rep" =~ ^[0-9]+$ ]] && (( rep >= 1 && rep <= ${#items[@]} )); then
            CHOICE="${items[$((rep - 1))]}"
            return 0
        fi
        info "${R}Choix invalide${N}"
    done
}

# ---------------------------------------------------------------- prérequis
for cmd in git jq sftp; do
    command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' introuvable (brew install $cmd)"
done
[[ -d "$REPO_DIR/.git" ]] || die "$REPO_DIR n'est pas un dépôt git\n   → modifie REPO_DIR en haut du script"

title "Gestion des comptes de service — mep.token"

# ---------------------------------------------------------------- dépôt à jour
status=$(git -C "$REPO_DIR" status --porcelain)
[[ -z "$status" ]] || die "le dépôt contient des modifications non commitées, nettoie avant :\n$status"
info "🔄 Mise à jour du dépôt"
run git -C "$REPO_DIR" pull --rebase --quiet

# ---------------------------------------------------------------- 1. environnement
choose "Environnement ?" "${ENVS[@]}"
ENV_NAME="$CHOICE"
env_config "$ENV_NAME"
TOKEN_PATH="$REPO_DIR/$TOKEN_FILE"
[[ -f "$TOKEN_PATH" ]] || die "fichier introuvable : $TOKEN_PATH"
jq empty "$TOKEN_PATH" 2>/dev/null || die "$TOKEN_PATH n'est pas un JSON valide"
[[ "$ENV_NAME" == "prod" ]] && info "${R}${B}⚠️  Tu travailles sur la PROD${N}"

# ---------------------------------------------------------------- 2. action
choose "Que veux-tu faire ?" \
    "Ajouter des comptes de service" \
    "Supprimer des comptes de service (serviceaccounts_to_delete)" \
    "Redéposer le mep.token actuel sur le serveur (sans modification)"
ACTION_CHOICE="$CHOICE"

# ---------------------------------------------------------------- SFTP
sftp_upload() {
    local stamp user backup batch out local_size
    mkdir -p "$BACKUP_DIR"
    stamp=$(date +%Y%m%d-%H%M%S)
    user="${SFTP_TARGET%@*}"
    backup="$BACKUP_DIR/${user}_mep.token.$stamp"

    title "Dépôt SFTP"
    info "Cible : ${B}$SFTP_TARGET:$REMOTE_PATH${N}"
    if ! ask_yn "Envoyer le fichier sur le serveur ?" o; then
        info "⏭️  Upload annulé. Relance le script et choisis « Redéposer » plus tard."
        return 0
    fi

    batch=$(mktemp)
    cat > "$batch" <<EOF
-get $REMOTE_PATH $backup
put $TOKEN_PATH $REMOTE_PATH
ls -l $REMOTE_PATH
EOF
    if ! out=$(sftp -b "$batch" "$SFTP_TARGET" 2>&1); then
        rm -f "$batch"
        echo "$out" >&2
        die "échec SFTP (vérifie la clé SSH / ~/.ssh/config)"
    fi
    rm -f "$batch"
    echo "$out"

    local_size=$(wc -c < "$TOKEN_PATH" | tr -d ' ')
    if grep -q "[[:space:]]$local_size[[:space:]]" <<<"$out"; then
        info "${G}✅ Fichier déposé ($local_size octets)${N}"
    else
        info "${Y}⚠️  Taille locale $local_size octets introuvable dans le listing distant, vérifie.${N}"
    fi
    [[ -f "$backup" ]] && info "💾 Ancienne version sauvegardée : $backup"
    return 0
}

if [[ "$ACTION_CHOICE" == Redéposer* ]]; then
    sftp_upload
    info "\n🎉 Terminé"
    exit 0
fi

DELETE=false
[[ "$ACTION_CHOICE" == Supprimer* ]] && DELETE=true

# ---------------------------------------------------------------- 3. namespace
ALL_NS=()
while IFS= read -r ns; do ALL_NS+=("$ns"); done \
    < <(jq -r '.namespaces[].namespace' "$TOKEN_PATH" | sort)

NAMESPACE=""
filtered=("${ALL_NS[@]}")
while [[ -z "$NAMESPACE" ]]; do
    info "\n${B}Namespace ?${N}  (numéro, nom exact, ou un mot pour filtrer)"
    for i in "${!filtered[@]}"; do
        printf '  %s%2d)%s %s\n' "$C" $((i + 1)) "$N" "${filtered[$i]}"
    done
    printf '> '
    read -r rep
    [[ -z "$rep" ]] && { filtered=("${ALL_NS[@]}"); continue; }

    if [[ "$rep" =~ ^[0-9]+$ ]] && (( rep >= 1 && rep <= ${#filtered[@]} )); then
        NAMESPACE="${filtered[$((rep - 1))]}"
    elif printf '%s\n' "${ALL_NS[@]}" | grep -qxF -- "$rep"; then
        NAMESPACE="$rep"
    else
        new=()
        for ns in "${ALL_NS[@]}"; do
            [[ "$ns" == *"$rep"* ]] && new+=("$ns")
        done
        if [[ ${#new[@]} -gt 0 ]]; then
            filtered=("${new[@]}")
        elif [[ "$DELETE" == "false" ]] \
             && [[ "$rep" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] \
             && ask_yn "Le namespace '${B}$rep${N}' n'existe pas. Le créer ?"; then
            NAMESPACE="$rep"
        else
            info "${R}Aucun namespace ne correspond à '$rep'${N} (Entrée pour tout réafficher)"
        fi
    fi
done
info "→ Namespace : ${B}$NAMESPACE${N}"

# Affiche les comptes actuels du namespace
current=$(jq -r --arg ns "$NAMESPACE" \
    '.namespaces[] | select(.namespace == $ns) | (.serviceaccounts // [])[]' "$TOKEN_PATH" 2>/dev/null || true)
if [[ -n "$current" ]]; then
    info "\nComptes actuels dans ${B}$NAMESPACE${N} ($(wc -l <<<"$current" | tr -d ' ')) :"
    sed 's/^/    · /' <<<"$current"
fi

# ---------------------------------------------------------------- 4. comptes
if [[ "$DELETE" == "true" ]]; then
    FIELD="serviceaccounts_to_delete"; VERB="supprimer"
else
    FIELD="serviceaccounts"; VERB="ajouter"
fi

CHANGED=()
while [[ ${#CHANGED[@]} -eq 0 ]]; do
    info "\n${B}Compte(s) de service à $VERB${N} (séparés par des espaces) :"
    printf '> '
    read -r line
    ok=true; CHANGED=()
    for sa in $line; do
        if [[ ! "$sa" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || (( ${#sa} > 63 )); then
            info "${R}Nom invalide : '$sa'${N} (minuscules, chiffres, '-', 63 car. max)"
            ok=false; continue
        fi
        if jq -e --arg ns "$NAMESPACE" --arg sa "$sa" --arg f "$FIELD" \
            'any(.namespaces[]; .namespace == $ns and ((.[$f] // []) | index($sa)))' \
            "$TOKEN_PATH" >/dev/null; then
            info "${Y}ℹ️  '$sa' est déjà dans $FIELD, ignoré${N}"
            continue
        fi
        if [[ "$DELETE" == "true" ]] && ! grep -qxF -- "$sa" <<<"$current"; then
            ask_yn "${Y}'$sa' n'est pas dans la liste actuelle.${N} Le mettre quand même dans to_delete ?" \
                || continue
        fi
        # dédoublonne la saisie
        if [[ ${#CHANGED[@]} -eq 0 ]] || ! printf '%s\n' "${CHANGED[@]}" | grep -qxF -- "$sa"; then
            CHANGED+=("$sa")
        fi
    done
    [[ "$ok" == "false" ]] && CHANGED=()
    if [[ ${#CHANGED[@]} -eq 0 && "$ok" == "true" ]]; then
        ask_yn "Rien à modifier. Saisir d'autres noms ?" o || { info "Bye 👋"; exit 0; }
    fi
done

# ---------------------------------------------------------------- 5. modification
SAS_JSON=$(printf '%s\n' "${CHANGED[@]}" | jq -R . | jq -s .)
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

jq --indent 4 \
   --arg ns "$NAMESPACE" \
   --argjson sas "$SAS_JSON" \
   --argjson del "$DELETE" '
  (if any(.namespaces[]; .namespace == $ns) then .
   else .namespaces += [{"namespace": $ns, "serviceaccounts_to_delete": [], "serviceaccounts": []}]
   end)
  | .namespaces |= map(
      if .namespace == $ns then
        if $del then
          .serviceaccounts = ((.serviceaccounts // []) - $sas)
          | .serviceaccounts_to_delete = ((.serviceaccounts_to_delete // []) + $sas)
        else
          .serviceaccounts_to_delete = ((.serviceaccounts_to_delete // []) - $sas)
          | .serviceaccounts = ((.serviceaccounts // []) + $sas)
        end
      else . end)
' "$TOKEN_PATH" > "$TMP"
jq empty "$TMP" || die "JSON généré invalide, abandon"

title "Récapitulatif"
if [[ "$DELETE" == "true" ]]; then ACTION="Suppression"; else ACTION="Ajout"; fi
LIST=$(printf '%s, ' "${CHANGED[@]}"); LIST="${LIST%, }"
info "  Environnement : ${B}$ENV_NAME${N}"
info "  Namespace     : ${B}$NAMESPACE${N}"
info "  Action        : ${B}$ACTION${N}"
info "  Comptes       : ${B}$LIST${N}\n"
git --no-pager diff --no-index --color "$TOKEN_PATH" "$TMP" || true

echo
ask_yn "Valider, commiter et pousser ?" || die "annulé, rien n'a été modifié"

cat "$TMP" > "$TOKEN_PATH"
title "Commit & push"
run git -C "$REPO_DIR" add "$TOKEN_FILE"
run git -C "$REPO_DIR" commit --quiet -m "[$ENV_NAME] $ACTION SA $LIST dans $NAMESPACE"
run git -C "$REPO_DIR" push --quiet
info "${G}✅ Poussé sur $(git -C "$REPO_DIR" branch --show-current)${N}"

sftp_upload
info "\n🎉 Terminé"
