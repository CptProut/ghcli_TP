    local rel="$1" cfg target remote stamp backup batch out size
    cfg=$(sftp_for "$rel")
    if [[ -z "$cfg" ]]; then
        warn "Pas de cible SFTP configurée pour ${B}$rel${N}${Y} (fonction sftp_for), à déposer à la main"
        return 0
    fi
    target="${cfg%%|*}"; remote="${cfg#*|}"
    mkdir -p "$BACKUP_DIR"
    stamp=$(date +%Y%m%d-%H%M%S)
    backup="$BACKUP_DIR/$(echo "$rel" | tr '/' '_').$stamp"

    info "\n📤 ${B}$rel${N} → $target:$remote"
    ask_yn "   Envoyer ?" o || { info "   ⏭️  ignoré"; return 0; }

    batch=$(mktemp)
    printf -- '-get %s %s\nput %s %s\nls -l %s\n' \
        "$remote" "$backup" "$REPO_DIR/$rel" "$remote" "$remote" > "$batch"
    if ! out=$(sftp -b "$batch" "$target" 2>&1); then
        rm -f "$batch"; echo "$out" >&2
        warn "échec SFTP pour $rel (clé SSH / ~/.ssh/config ?)"
        return 0
