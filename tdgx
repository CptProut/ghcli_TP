          | .serviceaccounts_to_delete = addu(.serviceaccounts_to_delete // []; $sas)
        else
            (if has("serviceaccounts_to_delete") then .serviceaccounts_to_delete -= $sas else . end)
        end)
    ' "$f" > "$tmp" || { rm -f "$tmp"; die "jq a échoué sur $f"; }
    jq empty "$tmp" || { rm -f "$tmp"; die "JSON invalide généré pour $f"; }
    cat "$tmp" > "$f"
    rm -f "$tmp"
